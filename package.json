{
  "name": "obratrix",
  "version": "1.0.0",
  "description": "Gestão de obras para construtoras",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:baseline": "tsx scripts/capture-schema-baseline.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check-prefix": "tsx scripts/check-prefix.ts",
    "db:test-rls": "tsx scripts/test-rls.ts"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.8",
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postgres": "^3.4.9",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
